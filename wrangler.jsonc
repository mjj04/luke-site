{
  // Must match the Worker's name in the Cloudflare dashboard
  "name": "luke-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "luke.flyguyry.co.uk", "custom_domain": true }
  ]
}
